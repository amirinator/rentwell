# ---------------------------------------------------------------------------
# Rentwell local environment. Copy to .env: `cp .env.example .env`
# Every default below works against `docker compose up`. No paid services and
# no external credentials are required for the demo.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- API -------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173
GRAPHQL_PATH=/graphql
GRAPHQL_MAX_COMPLEXITY=1200
GRAPHQL_MAX_DEPTH=12
GRAPHQL_INTROSPECTION=true

# --- Session / security ----------------------------------------------------
# 32+ chars. Replace in any non-local deployment.
SESSION_SECRET=rentwell-local-development-session-secret-change-me
SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=rentwell.sid
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=rentwell.csrf
PASSWORD_HASH_MEMORY_KIB=19456
PASSWORD_HASH_ITERATIONS=2
PASSWORD_HASH_PARALLELISM=1

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=rentwell
POSTGRES_PASSWORD=rentwell
POSTGRES_DB=rentwell
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rentwell:rentwell@localhost:5432/rentwell?schema=public&connection_limit=15
# Used by integration tests; created/dropped by the test harness.
TEST_DATABASE_URL=postgresql://rentwell:rentwell@localhost:5432/rentwell_test?schema=public

# --- Redis / BullMQ --------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=rentwell
WORKER_CONCURRENCY=4
WORKER_SHUTDOWN_GRACE_MS=15000
IMPORT_BATCH_SIZE=250
IMPORT_MAX_ROWS=50000
IMPORT_MAX_FILE_BYTES=26214400

# --- Object storage (MinIO, S3-compatible) ---------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=rentwell-imports
S3_ACCESS_KEY_ID=rentwell
S3_SECRET_ACCESS_KEY=rentwell-local-secret
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=300
MINIO_CONSOLE_PORT=9001

# --- Outbox dispatcher -----------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=750
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=12
OUTBOX_LAG_WARN_SECONDS=60

# --- Banking provider simulator --------------------------------------------
# `simulator` is the only provider shipped in the public repository.
BANK_PROVIDER=simulator
BANK_SIMULATOR_SEED=rentwell-demo
BANK_SIMULATOR_WEBHOOK_SECRET=rentwell-local-webhook-secret
BANK_SIMULATOR_DUPLICATE_RATE=0.08
BANK_SIMULATOR_LATE_RATE=0.06
BANK_SIMULATOR_FAILURE_RATE=0.05
BANK_SYNC_PAGE_SIZE=100

# --- AI investigation assistant --------------------------------------------
# `mock` is deterministic and requires no credentials. `anthropic` needs a key.
AI_PROVIDER=mock
AI_MODEL=claude-sonnet-5
AI_PROMPT_VERSION=2026-09-01
AI_MAX_TOOL_CALLS=8
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=2048
# ANTHROPIC_API_KEY=

# --- Observability ---------------------------------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=rentwell
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Accounting policy -----------------------------------------------------
BASE_CURRENCY=USD
